<UserControl
    x:Class="Ryujinx.Ava.UI.Views.Settings.SettingsNetworkView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ext="clr-namespace:Ryujinx.Ava.Common.Markup"
    xmlns:viewModels="clr-namespace:Ryujinx.Ava.UI.ViewModels"
    mc:Ignorable="d"
    x:DataType="viewModels:SettingsViewModel">
    <Design.DataContext>
        <viewModels:SettingsViewModel />
    </Design.DataContext>
    <ScrollViewer
        Name="NetworkPage"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">
        <Border Classes="settings">
            <StackPanel
                Margin="10"
                HorizontalAlignment="Stretch"
                Orientation="Vertical"
                Spacing="10">
                <TextBlock Classes="h1" Text="{ext:Locale SettingsTabNetworkMultiplayer}" />
                <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                        Text="{ext:Locale MultiplayerMode}"
                        ToolTip.Tip="{ext:Locale MultiplayerModeTooltip}"
                        Width="200" />
                    <ComboBox SelectedIndex="{Binding MultiplayerModeIndex}"
                        ToolTip.Tip="{ext:Locale MultiplayerModeTooltip}"
                        HorizontalContentAlignment="Left"
                        Width="250">
                        <ComboBoxItem
                            Content="{ext:Locale MultiplayerModeDisabled}" />
                        <ComboBoxItem
                            Content="{ext:Locale MultiplayerModeLdnRyu}" />
                        <ComboBoxItem
                            Content="{ext:Locale MultiplayerModeLdnMitm}" />
                        <ComboBoxItem
                            Content="{ext:Locale MultiplayerModeLanPlay}" />
                    </ComboBox>
                    <CheckBox Margin="10,0,0,0" IsChecked="{Binding DisableP2P}">
                        <TextBlock Text="{ext:Locale MultiplayerDisableP2P}"
                            ToolTip.Tip="{ext:Locale MultiplayerDisableP2PTooltip}" />
                    </CheckBox>
                </StackPanel>
                <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                        Text="{ext:Locale LdnPassphrase}"
                        ToolTip.Tip="{ext:Locale LdnPassphraseTooltip}"
                        Width="200" />
                    <TextBox Name="LdnPassphrase"
                        Text="{Binding LdnPassphrase}"
                        Width="250"
                        MaxLength="16"
                        ToolTip.Tip="{ext:Locale LdnPassphraseInputTooltip}"
                        Watermark="{ext:Locale LdnPassphraseInputPublic}" />
                    <Button
                        Name="GenLdnPassButton"
                        Grid.Column="1"
                        MinWidth="90"
                        Margin="10,0,0,0"
                        ToolTip.Tip="{ext:Locale GenLdnPassTooltip}"
                        Click="GenLdnPassButton_OnClick">
                        <TextBlock HorizontalAlignment="Center"
                                    Text="{ext:Locale GenLdnPass}" />
                    </Button>
                    <Button
                        Name="ClearLdnPassButton"
                        Grid.Column="1"
                        MinWidth="90"
                        Margin="10,0,0,0"
                        ToolTip.Tip="{ext:Locale ClearLdnPassTooltip}"
                        Click="ClearLdnPassButton_OnClick">
                        <TextBlock HorizontalAlignment="Center"
                                    Text="{ext:Locale ClearLdnPass}" />
                    </Button>
                </StackPanel>
                <StackPanel Margin="10,0,0,0"
                    Orientation="Horizontal"
                    IsVisible="{Binding IsLanPlaySelected}">
                    <TextBlock VerticalAlignment="Center"
                        Text="{ext:Locale MultiplayerLanPlayServer}"
                        ToolTip.Tip="{ext:Locale MultiplayerLanPlayServerTooltip}"
                        Width="200" />
                    <TextBox Name="LanPlayServer"
                        Text="{Binding LanPlayServer}"
                        Width="250"
                        ToolTip.Tip="{ext:Locale MultiplayerLanPlayServerTooltip}"
                        Watermark="{ext:Locale MultiplayerLanPlayServerWatermark}" />
                    <Button
                        Name="TestLanPlayButton"
                        MinWidth="90"
                        Margin="10,0,0,0"
                        IsEnabled="{Binding !IsLanPlayTestRunning}"
                        ToolTip.Tip="{ext:Locale MultiplayerLanPlayTestTooltip}"
                        Click="TestLanPlayButton_OnClick">
                        <TextBlock HorizontalAlignment="Center"
                            Text="{ext:Locale MultiplayerLanPlayTest}" />
                    </Button>
                </StackPanel>
                <TextBlock Margin="10,0,0,0"
                    Name="LanPlayTestResultBlock"
                    FontStyle="Italic"
                    MaxWidth="600"
                    TextWrapping="Wrap"
                    Focusable="False"
                    IsVisible="{Binding IsLanPlayTestResultVisible}"
                    Text="{Binding LanPlayTestResult}" />
                <StackPanel Margin="10,0,0,0"
                    Orientation="Horizontal"
                    IsVisible="{Binding IsLanPlaySelected}">
                    <TextBlock VerticalAlignment="Center"
                        Text="{ext:Locale MultiplayerLanPlayVirtualIp}"
                        ToolTip.Tip="{ext:Locale MultiplayerLanPlayVirtualIpTooltip}"
                        Width="200" />
                    <TextBox Name="LanPlayVirtualIp"
                        Text="{Binding LanPlayVirtualIp}"
                        Width="250"
                        ToolTip.Tip="{ext:Locale MultiplayerLanPlayVirtualIpTooltip}"
                        Watermark="{ext:Locale MultiplayerLanPlayVirtualIpWatermark}" />
                </StackPanel>
                <TextBlock  Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Name="InvalidLdnPassphraseBlock"
                    FontStyle="Italic"
                    IsVisible="{Binding IsInvalidLdnPassphraseVisible}"
                    Focusable="False"
                    Text="{ext:Locale InvalidLdnPassphrase}" />
                <Separator Height="1" />
                <TextBlock Classes="h1" Text="{ext:Locale SettingsTabNetworkConnection}" />
                <CheckBox Margin="10,0,0,0" IsChecked="{Binding EnableInternetAccess}">
                    <TextBlock Text="{ext:Locale SettingsTabSystemEnableInternetAccess}"
                        ToolTip.Tip="{ext:Locale EnableInternetAccessTooltip}" />
                </CheckBox>
                <StackPanel Margin="10,0,0,0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                        Text="{ext:Locale SettingsTabNetworkInterface}"
                        ToolTip.Tip="{ext:Locale NetworkInterfaceTooltip}"
                        Width="200" />
                    <ComboBox SelectedIndex="{Binding NetworkInterfaceIndex}"
                        ToolTip.Tip="{ext:Locale NetworkInterfaceTooltip}"
                        HorizontalContentAlignment="Left"
                        ItemsSource="{Binding NetworkInterfaceList}"
                        Width="250" />
                </StackPanel>
                <Separator Height="1" />

                <!-- [Nextendo] Serveur personnalise. Basculement complet, pas une simple
                     redirection de trafic de jeu : cocher cette case et remplir les TROIS
                     champs ci-dessous (IP jeu, IP NAT, domaine de compte) redirige tout —
                     jeu, NAT, compte, amis, sauvegardes — vers l infrastructure d un tiers.
                     Sans les trois, Nextendo est simplement coupe (etat sur par defaut). C
                     est pour cela que le reglage vit ici, dans Reseau, et non dans l onglet
                     du service qu il remplace. -->
                <TextBlock Classes="h1" Text="{ext:Locale Dialog_Nextendo_OverrideTitle}" />
                <TextBlock Margin="10,0,0,0" Opacity="0.8" TextWrapping="Wrap" FontSize="12"
                           Text="{ext:Locale Dialog_Nextendo_OverrideDesc}" />

                <CheckBox Margin="10,0,0,0" Name="ServerOverrideToggle"
                          Content="{ext:Locale Dialog_Nextendo_OverrideEnable}" />

                <Grid Margin="10,0,0,0" ColumnDefinitions="200,300" RowDefinitions="Auto,Auto" Name="OverrideFields">
                    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                               Text="{ext:Locale Dialog_Nextendo_OverrideServerIp}" />
                    <TextBox Grid.Row="0" Grid.Column="1" Name="ServerIpBox" MaxLength="45"
                             Watermark="{ext:Locale Dialog_Nextendo_OverrideServerIpHint}" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,0,0" VerticalAlignment="Center"
                               Text="{ext:Locale Dialog_Nextendo_OverrideNatIp}" />
                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" Name="NatIpBox" MaxLength="45"
                             Watermark="{ext:Locale Dialog_Nextendo_OverrideNatIpHint}" />
                </Grid>

                <TextBlock Margin="10,0,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
                           Text="{ext:Locale Dialog_Nextendo_OverrideNatWarning}" />

                <!-- [Nextendo] Champ à part et OBLIGATOIRE : redirige le COMPTE (connexion,
                     amis, sauvegardes en ligne) vers un autre backend compatible Nextendo.
                     N'a aucun rapport avec les deux champs jeu/NAT ci-dessus — voir
                     NextendoServerOverride.AccountDomainUrl. Toujours dans OverrideFields pour
                     hériter du même activer/désactiver que le reste, câblé en code-behind. -->
                <Grid Margin="10,12,0,0" ColumnDefinitions="200,400" Name="CustomDomainFields">
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Text="{ext:Locale Dialog_Nextendo_OverrideCustomDomain}" />
                    <TextBox Grid.Column="1" Name="CustomDomainBox" MaxLength="253"
                             Watermark="{ext:Locale Dialog_Nextendo_OverrideCustomDomainHint}" />
                </Grid>
                <TextBlock Margin="10,4,0,0" Opacity="0.7" TextWrapping="Wrap" FontSize="11"
                           Text="{ext:Locale Dialog_Nextendo_OverrideCustomDomainWarning}" />

                <StackPanel Margin="10,0,0,0" Orientation="Horizontal" Spacing="10">
                    <Button Name="SaveOverrideButton"
                            Content="{ext:Locale Dialog_Nextendo_OverrideSave}" />
                    <TextBlock Name="OverrideStatusText" VerticalAlignment="Center"
                               FontSize="12" IsVisible="False" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
